{
  "name": "clean-workspace-cli",
  "version": "2.0.0",
  "description": "🧹 CLI helper to clean dev environment junk — node_modules, caches, build artifacts and more.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "cw": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test",
    "benchmark": "node scripts/benchmark-scan.js",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "release:beta": "npm publish --tag beta"
  },
  "keywords": [
    "cli",
    "clean",
    "node_modules",
    "cache",
    "dev",
    "developer",
    "tools",
    "cleanup",
    "next",
    "react-native",
    "expo",
    "npm-cache",
    "yarn-cache"
  ],
  "author": "Thiago Silva",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.3",
    "execa": "^8.0.1",
    "glob": "^10.3.10",
    "inquirer": "^9.2.12",
    "ora": "^8.0.1",
    "pretty-bytes": "^6.1.1"
  },
  "files": [
    "src/",
    "docs/",
    "scripts/",
    "README.md",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3"
  }
}
